# Plantilla de variables. Copia este archivo a .env.local y llena los valores.
# Se obtienen en Supabase → botón "Connect" → App Frameworks → Next.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOLO SERVIDOR. Supabase → Project Settings → API Keys → Secret keys.
# Da control total de la base: nunca la compartas ni la subas a GitHub.
# La usa la pantalla de Usuarios para dar de alta personas.
SUPABASE_SECRET_KEY=
