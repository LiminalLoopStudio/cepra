# Caddy en el VPS de Vultr: recibe https://cepra.shadowlimitstudio.com.mx
# (certificado automático de Let's Encrypt) y lo manda por WireGuard al mini PC.
cepra.shadowlimitstudio.com.mx {
	encode zstd gzip
	reverse_proxy 10.10.10.2:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}
}
